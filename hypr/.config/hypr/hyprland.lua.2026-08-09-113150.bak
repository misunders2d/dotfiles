-- Hyprland Lua config mirroring hyprland.conf.
-- Source of truth used for conversion: hyprland.conf in this directory.
-- Hyprland >=0.55 prefers ~/.config/hypr/hyprland.lua when present.

------------------
---- MONITORS ----
------------------

hl.monitor({
  output = "",
  mode = "preferred",
  position = "auto",
  scale = 1,
})
-- hl.monitor({ output = "eDP-1", mode = "preferred", position = "auto", scale = 1.33 })

---------------------
---- MY PROGRAMS ----
---------------------

local terminal = "kitty"
local fileManager = terminal .. " yazi"
-- local fileManager = "dolphin"
local menu = "walker"
local mainMod = "SUPER"

-------------------
---- AUTOSTART ----
-------------------

hl.on("hyprland.start", function()
  hl.exec_cmd([[sh -lc 'sleep 1; exec waybar -l info >> /home/misunderstood/.cache/waybar-autostart.log 2>&1']])
  hl.exec_cmd("elephant")
  hl.exec_cmd("walker --gapplication-service")
  hl.exec_cmd("hyprpolkitagent")
  hl.exec_cmd("awww-daemon")
  hl.exec_cmd("hypridle")
end)

